# Core Run Ledgers, Logs & Session Histories
.orchestrator/
*.log
*.jsonl
events.jsonl
.cache/
scratch/
*.tmp
*.lock

# Historical Run Evidence & Receipts
channel_assets/evidence/
*.receipt.json

# OAuth Credentials & Secrets (Never Commit)
channel_assets/client_secrets.json
*.token.json
client_secrets.json
.yt_oauth_token.json
.yt_client_secrets.json

# Python & Virtual Environments (Strictly Single .venv at root)
.venv/
.venv-flux2/
__pycache__/
*.py[cod]
*$py.class
.ruff_cache/
.pytest_cache/

# OS Metadata
.DS_Store
.AppleDouble
.LSOverride

# Local AI Models & Binary Weights
models/
tools/kokoro_models/*.onnx
tools/kokoro_models/*.bin
tools/ntsc-rs.app/

# Generated Video Outputs & Per-Scene Render Caches
output/
shorts/*/output/
shorts/*/videos/
shorts/*/cache/
long_form/*/output/
long_form/*/videos/
long_form/*/cache/
demos/

# Channel-specific data (never commit)
configs/channels/*
!configs/channels/default.yaml
configs/voice_persona.md
channel_assets/voice.md
channel_assets/POLICY.md
channel_assets/YOUTUBE_API_GUIDE.md
channel_assets/scientific_dossiers.json
channel_assets/series_bible.json
channel/uploaded_videos.txt
research/scientific_dossiers.json
CONTENT_TRACKER.md
